	column 'Delivery Outcome' =
			
			SWITCH(
			    TRUE(),
			    'Fact Orders'[is_delivery_eligible] <> TRUE(), BLANK(),
			    'Fact Orders'[is_on_time_delivery] = TRUE(), "On time",
			    'Fact Orders'[is_on_time_delivery] = FALSE(), "Late",
			    BLANK()
			)
		lineageTag: 8ef10eee-f9e9-449a-829c-1a38e7b2de44
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'Fact Orders' = m
